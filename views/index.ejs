<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SpeedPL — Uczciwy test prędkości internetu</title>
  <meta name="description" content="Wielostrumieniowy test prędkości internetu: pobieranie, wysyłanie, ping, jitter, bufferbloat i diagnostyka łącza.">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23090d16'/%3E%3Cpath d='M7 22a11 11 0 1 1 18 0' fill='none' stroke='%233b82f6' stroke-width='3' stroke-linecap='round'/%3E%3Cpath d='M16 17l5-6' stroke='%2310b981' stroke-width='2.5' stroke-linecap='round'/%3E%3Ccircle cx='16' cy='17' r='2' fill='%23f8fafc'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body data-groq-configured="<%= groqConfigured ? 'true' : 'false' %>" data-db-configured="<%= dbConfigured ? 'true' : 'false' %>">
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="brand-wordmark">SpeedPL</a>
      <nav class="topbar-nav" aria-label="Nawigacja główna">
        <a href="#pomiar" class="nav-link active" data-i18n="navMeasure">Pomiar</a>
        <a href="#wykres" class="nav-link" data-i18n="navChart">Wykres</a>
        <a href="#diagnostyka" class="nav-link" data-i18n="navDiagnostics">Diagnostyka</a>
        <a href="/history" class="nav-link" data-i18n="navHistory">Historia</a>
      </nav>
      <div class="topbar-actions">
        <select id="langSelect" class="lang-select" aria-label="Język / Language / Langue">
          <option value="pl">Polski</option>
          <option value="en">English</option>
          <option value="fr">Français</option>
        </select>
        <a href="/history" class="btn secondary btn-sm" data-i18n="viewHistory">Zobacz historię</a>
      </div>
    </div>
  </header>

  <main class="container" id="pomiar">
    <section class="page-intro">
      <h1 data-i18n="heroTitle">Uczciwy pomiar jakości łącza</h1>
      <p class="meta-line">
        <span data-i18n="heroMeta1">Wielostrumieniowy transfer HTTP</span>
        <span aria-hidden="true">·</span>
        <span data-i18n="heroMeta2">Rzeczywisty RTT i bufferbloat</span>
        <span aria-hidden="true">·</span>
        <span data-i18n="heroMeta3">Bez sztucznego wygładzania wyników</span>
      </p>
    </section>

    <section class="workspace-grid">
      <!-- Left: Focal Speedometer & Primary Control -->
      <div class="panel gauge-panel">
        <div class="phase-stepper" id="phaseStepper" aria-label="Etap testu">
          <span class="phase-step active" data-phase="idle" data-i18n="phaseIdle">Gotowy</span>
          <span class="phase-sep" aria-hidden="true">/</span>
          <span class="phase-step" data-phase="ping" data-i18n="phasePing">Ping</span>
          <span class="phase-sep" aria-hidden="true">/</span>
          <span class="phase-step" data-phase="download" data-i18n="phaseDownload">Pobieranie</span>
          <span class="phase-sep" aria-hidden="true">/</span>
          <span class="phase-step" data-phase="upload" data-i18n="phaseUpload">Wysyłanie</span>
          <span class="phase-sep" aria-hidden="true">/</span>
          <span class="phase-step" data-phase="done" data-i18n="phaseDone">Wynik</span>
        </div>

        <div class="gauge-wrap" data-testid="speed-gauge">
          <svg class="speed-gauge" viewBox="0 0 320 200" role="img" aria-label="Prędkościomierz pomiaru na żywo">
            <defs>
              <linearGradient id="gaugeDownloadGrad" x1="0%" y1="100%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#2563eb" />
                <stop offset="100%" stop-color="#60a5fa" />
              </linearGradient>
              <linearGradient id="gaugeUploadGrad" x1="0%" y1="100%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#059669" />
                <stop offset="100%" stop-color="#34d399" />
              </linearGradient>
            </defs>
            <!-- 240-deg arc centered at (160, 145), radius 112. Total arc length ~ 469.14 -->
            <path
              class="gauge-track"
              d="M 63.0 201.0 A 112 112 0 1 1 257.0 201.0"
              fill="none"
              stroke-width="14"
              stroke-linecap="round"
            />
            <path
              id="gaugeArc"
              class="gauge-arc"
              d="M 63.0 201.0 A 112 112 0 1 1 257.0 201.0"
              fill="none"
              stroke="url(#gaugeDownloadGrad)"
              stroke-width="14"
              stroke-linecap="round"
              stroke-dasharray="469.14"
              stroke-dashoffset="469.14"
            />
            <g class="gauge-ticks" aria-hidden="true">
              <text x="48" y="196">0</text>
              <text x="36" y="122">25</text>
              <text x="82" y="54">100</text>
              <text x="160" y="28" text-anchor="middle">250</text>
              <text x="238" y="54" text-anchor="end">500</text>
              <text x="284" y="122" text-anchor="end">1000</text>
              <text x="276" y="196" text-anchor="end">2G+</text>
            </g>
          </svg>
          <div class="gauge-readout">
            <div class="gauge-phase-label" id="gaugePhaseLabel" data-i18n="phaseIdle">Gotowy</div>
            <div class="gauge-value mono" id="gaugeValue">0.00</div>
            <div class="gauge-unit" id="gaugeUnit" data-i18n="unitMbps">Mb/s</div>
          </div>
        </div>

        <div class="progress-block">
          <div class="progress-track" aria-hidden="true">
            <div class="progress-bar" id="progressBar"></div>
          </div>
          <div class="status-row">
            <span class="status-text" id="statusText" role="status" aria-live="polite" data-i18n="statusReady">Gotowy do pomiaru.</span>
            <span class="elapsed-text mono" id="elapsedText">0.0 s</span>
          </div>
        </div>

        <div class="actions">
          <button id="startBtn" class="btn primary btn-lg" type="button" data-i18n="btnStart">Rozpocznij test</button>
          <button id="stopBtn" class="btn secondary btn-lg" type="button" disabled data-i18n="btnStop">Zatrzymaj</button>
          <button id="copySummaryBtn" class="btn secondary btn-lg" type="button" disabled data-i18n="btnCopyResult">Kopiuj wynik</button>
        </div>
      </div>

      <!-- Right: Configuration & Server Selection -->
      <div class="panel config-panel">
        <div class="panel-header-inline">
          <h2 data-i18n="configTitle">Konfiguracja pomiaru</h2>
          <div class="segmented" role="tablist" aria-label="Tryb testu" id="testPresetGroup">
            <button type="button" class="seg-btn active" role="tab" aria-selected="true" data-preset="full" data-i18n="presetFull">Pełny test</button>
            <button type="button" class="seg-btn" role="tab" aria-selected="false" data-preset="quick" data-i18n="presetQuick">Szybki</button>
            <button type="button" class="seg-btn" role="tab" aria-selected="false" data-preset="latency" data-i18n="presetLatency">Tylko ping</button>
          </div>
        </div>

        <div class="controls-grid">
          <div class="field field-full">
            <div class="field-label-row">
              <label for="serverSelect" data-i18n="serverLabel">Serwer testowy</label>
              <button type="button" id="probeServersBtn" class="link-btn" data-i18n="probeServers">Sprawdź ping serwerów</button>
            </div>
            <select id="serverSelect">
              <% servers.forEach(function (s) { %>
                <option
                  value="<%= s.id %>"
                  data-url="<%= s.url || '' %>"
                  data-location="<%= s.location || '' %>"
                  data-specs="<%= s.specs || '' %>"
                  <%= s.configured ? '' : 'disabled' %>
                ><%= s.name %><%= s.configured ? '' : ' (wymaga konfiguracji)' %></option>
              <% }) %>
            </select>
            <div id="serverSpecsLine" class="server-specs mono">
              <span>Host: <%= serverInfo.host %></span>
              <% if (serverInfo.location) { %>
                <span aria-hidden="true">·</span>
                <span>Lokalizacja: <%= serverInfo.location %></span>
              <% } %>
              <% if (serverInfo.provider) { %>
                <span aria-hidden="true">·</span>
                <span><%= serverInfo.provider %></span>
              <% } %>
              <span aria-hidden="true">·</span>
              <span><%= serverInfo.protocol %> · <%= serverInfo.cpuCount %> vCPU · <%= serverInfo.randomPoolMb %> MB CSPRNG</span>
            </div>
            <div id="serverProbeResult" class="field-hint mono" aria-live="polite"></div>
          </div>

          <div class="field">
            <label for="streamsSelect" data-i18n="streamsLabel">Równoległe strumienie</label>
            <select id="streamsSelect">
              <option value="1" data-i18n="stream1">1 strumień</option>
              <option value="2" data-i18n="stream2">2 strumienie</option>
              <option value="4" selected data-i18n="stream4">4 strumienie</option>
              <option value="6" data-i18n="stream6">6 strumieni</option>
              <option value="8" data-i18n="stream8">8 strumieni</option>
            </select>
          </div>

          <div class="field">
            <label for="pingCountSelect" data-i18n="pingCountLabel">Liczba prób pingu</label>
            <select id="pingCountSelect">
              <option value="12" data-i18n-probes="12">12 prób</option>
              <option value="20" selected data-i18n-probes="20">20 prób</option>
              <option value="40" data-i18n-probes="40">40 prób</option>
            </select>
          </div>

          <div class="field">
            <label for="sizeSelect" data-i18n="dlModeLabel">Pomiar pobierania</label>
            <select id="sizeSelect">
              <option value="auto:8000" selected data-i18n="modeAuto8">Automatyczny (8 s)</option>
              <option value="auto:4000" data-i18n="modeAuto4">Szybki (4 s)</option>
              <option value="8388608" data-i18n-fixed-mb="8">Stały: 8 MB</option>
              <option value="16777216" data-i18n-fixed-mb="16">Stały: 16 MB</option>
              <option value="33554432" data-i18n-fixed-mb="32">Stały: 32 MB</option>
              <option value="67108864" data-i18n-fixed-mb="64">Stały: 64 MB</option>
            </select>
          </div>

          <div class="field">
            <label for="uploadSizeSelect" data-i18n="ulModeLabel">Pomiar wysyłania</label>
            <select id="uploadSizeSelect">
              <option value="auto:8000" selected data-i18n="modeAuto8">Automatyczny (8 s)</option>
              <option value="auto:4000" data-i18n="modeAuto4">Szybki (4 s)</option>
              <option value="4194304" data-i18n-fixed-mb="4">Stały: 4 MB</option>
              <option value="8388608" data-i18n-fixed-mb="8">Stały: 8 MB</option>
              <option value="16777216" data-i18n-fixed-mb="16">Stały: 16 MB</option>
              <option value="32768000" data-i18n-fixed-mb="32">Stały: 32 MB</option>
            </select>
          </div>
        </div>

        <hr class="divider">

        <div class="toggles">
          <label class="checkbox">
            <input type="checkbox" id="saveHistory" checked>
            <span id="saveHistoryLabel" data-i18n="<%= dbConfigured ? 'optSaveBoth' : 'optSaveLocal' %>">Zapisuj wyniki w historii (lokalnie<%= dbConfigured ? ' i w bazie danych' : '' %>)</span>
          </label>
          <label class="checkbox">
            <input type="checkbox" id="autoAnalyze" <%= groqConfigured ? '' : 'disabled' %>>
            <span id="autoAnalyzeLabel" data-i18n="<%= groqConfigured ? 'optAutoAnalyze' : 'optAutoAnalyzeDisabled' %>">Automatycznie analizuj wynik przez Groq AI<%= groqConfigured ? '' : ' (wymaga GROQ_API_KEY)' %></span>
          </label>
        </div>
      </div>
    </section>

    <!-- 5-Metric Telemetry Strip -->
    <section class="metric-grid" aria-label="Wyniki pomiaru">
      <div class="metric">
        <span class="metric-label" data-i18n="kpiDownload">Pobieranie</span>
        <div class="metric-main">
          <strong class="mono" id="downloadValue">--</strong>
          <span class="metric-unit" data-i18n="unitMbps">Mb/s</span>
        </div>
        <small class="metric-detail mono" id="downloadDetail" data-i18n="detailWaiting">Oczekuje na test</small>
      </div>
      <div class="metric">
        <span class="metric-label" data-i18n="kpiUpload">Wysyłanie</span>
        <div class="metric-main">
          <strong class="mono" id="uploadValue">--</strong>
          <span class="metric-unit" data-i18n="unitMbps">Mb/s</span>
        </div>
        <small class="metric-detail mono" id="uploadDetail" data-i18n="detailWaiting">Oczekuje na test</small>
      </div>
      <div class="metric">
        <span class="metric-label" data-i18n="kpiPing">Ping (mediana)</span>
        <div class="metric-main">
          <strong class="mono" id="pingValue">--</strong>
          <span class="metric-unit" data-i18n="unitMs">ms</span>
        </div>
        <small class="metric-detail mono" id="pingDetail" data-i18n="detailPingIdle">min · P95 · max</small>
      </div>
      <div class="metric">
        <span class="metric-label" data-i18n="kpiJitter">Jitter</span>
        <div class="metric-main">
          <strong class="mono" id="jitterValue">--</strong>
          <span class="metric-unit" data-i18n="unitMs">ms</span>
        </div>
        <small class="metric-detail mono" id="jitterDetail" data-i18n="detailJitterIdle">Zmienność RTT</small>
      </div>
      <div class="metric">
        <span class="metric-label" data-i18n="kpiLoaded">Pod obciążeniem</span>
        <div class="metric-main">
          <strong class="mono" id="loadedValue">--</strong>
          <span class="metric-unit" data-i18n="unitMs">ms</span>
        </div>
        <small class="metric-detail mono" id="loadedDetail" data-i18n="detailLoadedIdle">Wzrost · Pob. · Wys.</small>
      </div>
    </section>

    <!-- Live Chart Panel -->
    <section class="panel" id="wykres">
      <div class="panel-header-inline">
        <div>
          <h2 data-i18n="chartTitle">Telemetria w czasie rzeczywistym</h2>
          <p class="meta-line" data-i18n="chartSubtitle">Próbkowanie co 200 ms oraz rozkład opóźnień RTT</p>
        </div>
        <div class="segmented" role="tablist" aria-label="Widok wykresu" id="chartModeGroup">
          <button type="button" class="seg-btn active" role="tab" aria-selected="true" data-chart="throughput" data-i18n="chartThroughput">Przepustowość (Mb/s)</button>
          <button type="button" class="seg-btn" role="tab" aria-selected="false" data-chart="ping" data-i18n="chartPing">Rozkład pingu (ms)</button>
        </div>
      </div>
      <div class="chart-stage">
        <canvas id="speedChart" data-testid="speed-chart"></canvas>
      </div>
    </section>

    <!-- Diagnostics + Groq AI Section -->
    <section class="diagnostics-grid" id="diagnostyka">
      <div class="panel">
        <div class="panel-header-inline">
          <div>
            <h2 data-i18n="diagTitle">Diagnostyka łącza i Bufferbloat</h2>
            <p class="meta-line" data-i18n="diagSubtitle">Ocena lokalna na podstawie realnych progów</p>
          </div>
          <div class="grade-readout mono" id="bufferbloatGradeBadge">Klasa: --</div>
        </div>

        <div id="bufferbloatSummary" class="bloat-summary" data-i18n="bloatPrompt">
          Uruchom test, aby obliczyć klasę stabilności kolejki (Bufferbloat A+–F) oraz gotowość do gier, 4K i pracy zdalnej.
        </div>

        <div id="useCaseMatrix" class="use-case-list" aria-live="polite">
          <div class="use-case-empty" data-i18n="useCaseEmpty">Brak wyników pomiaru do oceny.</div>
        </div>
      </div>

      <div class="panel" id="analiza">
        <div class="panel-header-inline wrap">
          <div>
            <h2 data-i18n="aiTitle">Analiza AI (Groq)</h2>
            <p class="meta-line" id="groqAvailabilityNote" data-i18n="<%= groqConfigured ? 'aiReadyNote' : 'aiNoKeyNote' %>">
              <%= groqConfigured ? 'Model gotowy po zakończeniu pomiaru' : 'GROQ_API_KEY nie jest skonfigurowany na serwerze' %>
            </p>
          </div>
          <div class="ai-controls">
            <select id="useCaseSelect" aria-label="Tryb analizy AI">
              <option value="general" selected data-i18n="aiUseGeneral">Ogólna ocena</option>
              <option value="gaming" data-i18n="aiUseGaming">Gry online</option>
              <option value="streaming" data-i18n="aiUseStreaming">Streaming 4K</option>
              <option value="remote_work" data-i18n="aiUseRemote">Praca zdalna</option>
            </select>
            <button id="analyzeBtn" class="btn secondary" type="button" disabled data-i18n="aiAnalyzeBtn">Analizuj przez AI</button>
            <button id="copyAnalysisBtn" class="btn secondary" type="button" disabled data-i18n="aiCopyBtn">Kopiuj</button>
          </div>
        </div>
        <div id="analysisMeta" class="analysis-meta mono"></div>
        <div id="analysisText" class="analysis" data-i18n="<%= groqConfigured ? 'aiPlaceholderReady' : 'aiPlaceholderNoKey' %>">
          <%= groqConfigured ? 'Po zakończeniu testu kliknij „Analizuj przez AI”, aby uzyskać spersonalizowane rekomendacje.' : 'Aby włączyć komentarz Groq AI, ustaw zmienną środowiskową GROQ_API_KEY. Lokalna diagnostyka po lewej działa zawsze bez klucza.' %>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <span>SpeedPL</span>
      <span aria-hidden="true">·</span>
      <span data-i18n="footerStreamNote">Losowy strumień bajtów po stronie serwera</span>
      <span aria-hidden="true">·</span>
      <a href="/history" data-i18n="footerHistoryLink">Historia i eksport CSV</a>
    </div>
  </footer>

  <script src="/vendor/chart.js/chart.umd.js"></script>
  <script src="/vendor/i18n.js"></script>
  <script src="/vendor/diagnostics.js"></script>
  <script src="/js/speedtest.js"></script>
</body>
</html>