<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SpeedPL — Uczciwy test prędkości internetu</title>
  <meta name="description" content="Wielostrumieniowy test prędkości internetu: pobieranie, wysyłanie, ping, jitter, bufferbloat i diagnostyka łącza.">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23090d16'/%3E%3Cpath d='M7 22a11 11 0 1 1 18 0' fill='none' stroke='%233b82f6' stroke-width='3' stroke-linecap='round'/%3E%3Cpath d='M16 17l5-6' stroke='%2310b981' stroke-width='2.5' stroke-linecap='round'/%3E%3Ccircle cx='16' cy='17' r='2' fill='%23f8fafc'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body data-groq-configured="<%= groqConfigured ? 'true' : 'false' %>" data-db-configured="<%= dbConfigured ? 'true' : 'false' %>">
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="brand-wordmark">SpeedPL</a>
      <nav class="topbar-nav" aria-label="Nawigacja główna">
        <a href="#pomiar" class="nav-link active">Pomiar</a>
        <a href="#wykres" class="nav-link">Wykres</a>
        <a href="#diagnostyka" class="nav-link">Diagnostyka</a>
        <a href="/history" class="nav-link">Historia</a>
      </nav>
      <div class="topbar-actions">
        <a href="/history" class="btn secondary btn-sm">Zobacz historię</a>
      </div>
    </div>
  </header>

  <main class="container" id="pomiar">
    <section class="page-intro">
      <h1>Uczciwy pomiar jakości łącza</h1>
      <p class="meta-line">
        <span>Wielostrumieniowy transfer HTTP</span>
        <span aria-hidden="true">·</span>
        <span>Rzeczywisty RTT i bufferbloat</span>
        <span aria-hidden="true">·</span>
        <span>Bez sztucznego wygładzania wyników</span>
      </p>
    </section>

    <section class="workspace-grid">
      <!-- Left: Focal Speedometer & Primary Control -->
      <div class="panel gauge-panel">
        <div class="phase-stepper" id="phaseStepper" aria-label="Etap testu">
          <span class="phase-step active" data-phase="idle">Gotowy</span>
          <span class="phase-sep" aria-hidden="true">/</span>
          <span class="phase-step" data-phase="ping">Ping</span>
          <span class="phase-sep" aria-hidden="true">/</span>
          <span class="phase-step" data-phase="download">Pobieranie</span>
          <span class="phase-sep" aria-hidden="true">/</span>
          <span class="phase-step" data-phase="upload">Wysyłanie</span>
          <span class="phase-sep" aria-hidden="true">/</span>
          <span class="phase-step" data-phase="done">Wynik</span>
        </div>

        <div class="gauge-wrap" data-testid="speed-gauge">
          <svg class="speed-gauge" viewBox="0 0 320 200" role="img" aria-label="Prędkościomierz pomiaru na żywo">
            <defs>
              <linearGradient id="gaugeDownloadGrad" x1="0%" y1="100%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#2563eb" />
                <stop offset="100%" stop-color="#60a5fa" />
              </linearGradient>
              <linearGradient id="gaugeUploadGrad" x1="0%" y1="100%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#059669" />
                <stop offset="100%" stop-color="#34d399" />
              </linearGradient>
            </defs>
            <!-- 240-deg arc centered at (160, 145), radius 112. Total arc length ~ 469.14 -->
            <path
              class="gauge-track"
              d="M 63.0 201.0 A 112 112 0 1 1 257.0 201.0"
              fill="none"
              stroke-width="14"
              stroke-linecap="round"
            />
            <path
              id="gaugeArc"
              class="gauge-arc"
              d="M 63.0 201.0 A 112 112 0 1 1 257.0 201.0"
              fill="none"
              stroke="url(#gaugeDownloadGrad)"
              stroke-width="14"
              stroke-linecap="round"
              stroke-dasharray="469.14"
              stroke-dashoffset="469.14"
            />
            <g class="gauge-ticks" aria-hidden="true">
              <text x="48" y="196">0</text>
              <text x="36" y="122">25</text>
              <text x="82" y="54">100</text>
              <text x="160" y="28" text-anchor="middle">250</text>
              <text x="238" y="54" text-anchor="end">500</text>
              <text x="284" y="122" text-anchor="end">1000</text>
              <text x="276" y="196" text-anchor="end">2G+</text>
            </g>
          </svg>
          <div class="gauge-readout">
            <div class="gauge-phase-label" id="gaugePhaseLabel">Gotowy</div>
            <div class="gauge-value mono" id="gaugeValue">0.00</div>
            <div class="gauge-unit" id="gaugeUnit">Mb/s</div>
          </div>
        </div>

        <div class="progress-block">
          <div class="progress-track" aria-hidden="true">
            <div class="progress-bar" id="progressBar"></div>
          </div>
          <div class="status-row">
            <span class="status-text" id="statusText" role="status" aria-live="polite">Gotowy do pomiaru.</span>
            <span class="elapsed-text mono" id="elapsedText">0.0 s</span>
          </div>
        </div>

        <div class="actions">
          <button id="startBtn" class="btn primary btn-lg" type="button">Rozpocznij test</button>
          <button id="stopBtn" class="btn secondary btn-lg" type="button" disabled>Zatrzymaj</button>
          <button id="copySummaryBtn" class="btn secondary btn-lg" type="button" disabled>Kopiuj wynik</button>
        </div>
      </div>

      <!-- Right: Configuration & Server Selection -->
      <div class="panel config-panel">
        <div class="panel-header-inline">
          <h2>Konfiguracja pomiaru</h2>
          <div class="segmented" role="tablist" aria-label="Tryb testu" id="testPresetGroup">
            <button type="button" class="seg-btn active" role="tab" aria-selected="true" data-preset="full">Pełny test</button>
            <button type="button" class="seg-btn" role="tab" aria-selected="false" data-preset="quick">Szybki</button>
            <button type="button" class="seg-btn" role="tab" aria-selected="false" data-preset="latency">Tylko ping</button>
          </div>
        </div>

        <div class="controls-grid">
          <div class="field field-full">
            <div class="field-label-row">
              <label for="serverSelect">Serwer testowy</label>
              <button type="button" id="probeServersBtn" class="link-btn">Sprawdź ping serwerów</button>
            </div>
            <select id="serverSelect">
              <% servers.forEach(function (s) { %>
                <option
                  value="<%= s.id %>"
                  data-url="<%= s.url || '' %>"
                  data-location="<%= s.location || '' %>"
                  data-specs="<%= s.specs || '' %>"
                  <%= s.configured ? '' : 'disabled' %>
                ><%= s.name %><%= s.configured ? '' : ' (wymaga konfiguracji)' %></option>
              <% }) %>
            </select>
            <div id="serverSpecsLine" class="server-specs mono">
              <span>Host: <%= serverInfo.host %></span>
              <% if (serverInfo.location) { %>
                <span aria-hidden="true">·</span>
                <span>Lokalizacja: <%= serverInfo.location %></span>
              <% } %>
              <% if (serverInfo.provider) { %>
                <span aria-hidden="true">·</span>
                <span><%= serverInfo.provider %></span>
              <% } %>
              <span aria-hidden="true">·</span>
              <span><%= serverInfo.protocol %> · <%= serverInfo.cpuCount %> vCPU · <%= serverInfo.randomPoolMb %> MB CSPRNG</span>
            </div>
            <div id="serverProbeResult" class="field-hint mono" aria-live="polite"></div>
          </div>

          <div class="field">
            <label for="streamsSelect">Równoległe strumienie</label>
            <select id="streamsSelect">
              <option value="1">1 strumień</option>
              <option value="2">2 strumienie</option>
              <option value="4" selected>4 strumienie</option>
              <option value="6">6 strumieni</option>
              <option value="8">8 strumieni</option>
            </select>
          </div>

          <div class="field">
            <label for="pingCountSelect">Liczba prób pingu</label>
            <select id="pingCountSelect">
              <option value="12">12 prób</option>
              <option value="20" selected>20 prób</option>
              <option value="40">40 prób</option>
            </select>
          </div>

          <div class="field">
            <label for="sizeSelect">Pomiar pobierania</label>
            <select id="sizeSelect">
              <option value="auto:8000" selected>Automatyczny (8 s)</option>
              <option value="auto:4000">Szybki (4 s)</option>
              <option value="8388608">Stały: 8 MB</option>
              <option value="16777216">Stały: 16 MB</option>
              <option value="33554432">Stały: 32 MB</option>
              <option value="67108864">Stały: 64 MB</option>
            </select>
          </div>

          <div class="field">
            <label for="uploadSizeSelect">Pomiar wysyłania</label>
            <select id="uploadSizeSelect">
              <option value="auto:8000" selected>Automatyczny (8 s)</option>
              <option value="auto:4000">Szybki (4 s)</option>
              <option value="4194304">Stały: 4 MB</option>
              <option value="8388608">Stały: 8 MB</option>
              <option value="16777216">Stały: 16 MB</option>
              <option value="32768000">Stały: 32 MB</option>
            </select>
          </div>
        </div>

        <hr class="divider">

        <div class="toggles">
          <label class="checkbox">
            <input type="checkbox" id="saveHistory" checked>
            <span>Zapisuj wyniki w historii (lokalnie<%= dbConfigured ? ' i w bazie danych' : '' %>)</span>
          </label>
          <label class="checkbox">
            <input type="checkbox" id="autoAnalyze" <%= groqConfigured ? '' : 'disabled' %>>
            <span>Automatycznie analizuj wynik przez Groq AI<%= groqConfigured ? '' : ' (wymaga GROQ_API_KEY)' %></span>
          </label>
        </div>
      </div>
    </section>

    <!-- 5-Metric Telemetry Strip -->
    <section class="metric-grid" aria-label="Wyniki pomiaru">
      <div class="metric">
        <span class="metric-label">Pobieranie</span>
        <div class="metric-main">
          <strong class="mono" id="downloadValue">--</strong>
          <span class="metric-unit">Mb/s</span>
        </div>
        <small class="metric-detail mono" id="downloadDetail">Oczekuje na test</small>
      </div>
      <div class="metric">
        <span class="metric-label">Wysyłanie</span>
        <div class="metric-main">
          <strong class="mono" id="uploadValue">--</strong>
          <span class="metric-unit">Mb/s</span>
        </div>
        <small class="metric-detail mono" id="uploadDetail">Oczekuje na test</small>
      </div>
      <div class="metric">
        <span class="metric-label">Ping (mediana)</span>
        <div class="metric-main">
          <strong class="mono" id="pingValue">--</strong>
          <span class="metric-unit">ms</span>
        </div>
        <small class="metric-detail mono" id="pingDetail">min · P95 · max</small>
      </div>
      <div class="metric">
        <span class="metric-label">Jitter</span>
        <div class="metric-main">
          <strong class="mono" id="jitterValue">--</strong>
          <span class="metric-unit">ms</span>
        </div>
        <small class="metric-detail mono" id="jitterDetail">Zmienność RTT</small>
      </div>
      <div class="metric">
        <span class="metric-label">Pod obciążeniem</span>
        <div class="metric-main">
          <strong class="mono" id="loadedValue">--</strong>
          <span class="metric-unit">ms</span>
        </div>
        <small class="metric-detail mono" id="loadedDetail">Wzrost · Pob. · Wys.</small>
      </div>
    </section>

    <!-- Live Chart Panel -->
    <section class="panel" id="wykres">
      <div class="panel-header-inline">
        <div>
          <h2>Telemetria w czasie rzeczywistym</h2>
          <p class="meta-line">Próbkowanie co 200 ms oraz rozkład opóźnień RTT</p>
        </div>
        <div class="segmented" role="tablist" aria-label="Widok wykresu" id="chartModeGroup">
          <button type="button" class="seg-btn active" role="tab" aria-selected="true" data-chart="throughput">Przepustowość (Mb/s)</button>
          <button type="button" class="seg-btn" role="tab" aria-selected="false" data-chart="ping">Rozkład pingu (ms)</button>
        </div>
      </div>
      <div class="chart-stage">
        <canvas id="speedChart" data-testid="speed-chart"></canvas>
      </div>
    </section>

    <!-- Diagnostics + Groq AI Section -->
    <section class="diagnostics-grid" id="diagnostyka">
      <div class="panel">
        <div class="panel-header-inline">
          <div>
            <h2>Diagnostyka łącza i Bufferbloat</h2>
            <p class="meta-line">Ocena lokalna na podstawie realnych progów</p>
          </div>
          <div class="grade-readout mono" id="bufferbloatGradeBadge">Klasa: --</div>
        </div>

        <div id="bufferbloatSummary" class="bloat-summary">
          Uruchom test, aby obliczyć klasę stabilności kolejki (Bufferbloat A+–F) oraz gotowość do gier, 4K i pracy zdalnej.
        </div>

        <div id="useCaseMatrix" class="use-case-list" aria-live="polite">
          <div class="use-case-empty">Brak wyników pomiaru do oceny.</div>
        </div>
      </div>

      <div class="panel" id="analiza">
        <div class="panel-header-inline wrap">
          <div>
            <h2>Analiza AI (Groq)</h2>
            <p class="meta-line" id="groqAvailabilityNote">
              <%= groqConfigured ? 'Model gotowy po zakończeniu pomiaru' : 'GROQ_API_KEY nie jest skonfigurowany na serwerze' %>
            </p>
          </div>
          <div class="ai-controls">
            <select id="useCaseSelect" aria-label="Tryb analizy AI">
              <option value="general" selected>Ogólna ocena</option>
              <option value="gaming">Gry online</option>
              <option value="streaming">Streaming 4K</option>
              <option value="remote_work">Praca zdalna</option>
            </select>
            <button id="analyzeBtn" class="btn secondary" type="button" disabled>Analizuj przez AI</button>
            <button id="copyAnalysisBtn" class="btn secondary" type="button" disabled>Kopiuj</button>
          </div>
        </div>
        <div id="analysisMeta" class="analysis-meta mono"></div>
        <div id="analysisText" class="analysis">
          <%= groqConfigured ? 'Po zakończeniu testu kliknij „Analizuj przez AI”, aby uzyskać spersonalizowane rekomendacje.' : 'Aby włączyć komentarz Groq AI, ustaw zmienną środowiskową GROQ_API_KEY. Lokalna diagnostyka po lewej działa zawsze bez klucza.' %>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <span>SpeedPL</span>
      <span aria-hidden="true">·</span>
      <span>Losowy strumień bajtów po stronie serwera</span>
      <span aria-hidden="true">·</span>
      <a href="/history">Historia i eksport CSV</a>
    </div>
  </footer>

  <script src="/vendor/chart.js/chart.umd.js"></script>
  <script src="/vendor/diagnostics.js"></script>
  <script src="/js/speedtest.js"></script>
</body>
</html>