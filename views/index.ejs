<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SpeedPL - test prędkości internetu</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="topbar">
    <div class="brand">SpeedPL</div>
    <div class="subtitle">Uczciwy test prędkości internetu</div>
    <a href="/history" class="btn secondary nav-link">Historia</a>
  </header>

  <main class="container">
    <section class="panel controls">
      <div class="controls-grid">
        <div class="field">
          <label for="serverSelect">Serwer testowy</label>
          <select id="serverSelect">
            <% servers.forEach(function (s) { %>
              <option value="<%= s.id %>" <%= s.configured ? '' : 'disabled' %>><%= s.name %><%= s.configured ? '' : ' (wymaga konfiguracji)' %></option>
            <% }) %>
          </select>
        </div>
        <div class="field">
          <label for="streamsSelect">Równoległe strumienie</label>
          <select id="streamsSelect">
            <option value="1">1 strumień</option>
            <option value="2">2 strumienie</option>
            <option value="4" selected>4 strumienie</option>
            <option value="6">6 strumieni</option>
          </select>
        </div>
        <div class="field">
          <label for="sizeSelect">Rozmiar pobierania</label>
          <select id="sizeSelect">
            <option value="8388608">8 MB</option>
            <option value="16777216" selected>16 MB</option>
            <option value="33554432">32 MB</option>
            <option value="67108864">64 MB</option>
          </select>
        </div>
        <div class="field">
          <label for="uploadSizeSelect">Rozmiar wysyłania</label>
          <select id="uploadSizeSelect">
            <option value="4194304">4 MB</option>
            <option value="8388608" selected>8 MB</option>
            <option value="16777216">16 MB</option>
            <option value="33554432">32 MB</option>
          </select>
        </div>
      </div>
      <div class="actions">
        <button id="startBtn" class="btn primary">Rozpocznij test</button>
        <button id="stopBtn" class="btn secondary" disabled>Zatrzymaj</button>
      </div>
      <div class="toggles">
        <label class="checkbox">
          <input type="checkbox" id="saveHistory" checked>
          Zapisz wynik w historii (jeśli baza jest dostępna)
        </label>
        <label class="checkbox">
          <input type="checkbox" id="autoAnalyze">
          Automatycznie analizuj wynik przez Groq AI
        </label>
      </div>
    </section>

    <section class="panel results">
      <div class="metric-grid">
        <div class="metric"><span>Pobieranie</span><strong id="downloadValue">--</strong><small>Mb/s</small></div>
        <div class="metric"><span>Wysyłanie</span><strong id="uploadValue">--</strong><small>Mb/s</small></div>
        <div class="metric"><span>Ping</span><strong id="pingValue">--</strong><small id="pingDetail">ms</small></div>
        <div class="metric"><span>Jitter</span><strong id="jitterValue">--</strong><small>ms</small></div>
        <div class="metric"><span>Latencja pod obciążeniem</span><strong id="loadedValue">--</strong><small id="loadedDetail">ms</small></div>
      </div>
      <div class="progress-track" aria-hidden="true">
        <div class="progress-bar" id="progressBar"></div>
      </div>
      <div class="status" id="statusText">Gotowy.</div>
      <canvas id="speedChart" height="120"></canvas>
    </section>

    <section class="panel">
      <div class="row wrap">
        <h2>Analiza AI (Groq)</h2>
        <div class="ai-controls">
          <select id="useCaseSelect" aria-label="Tryb analizy AI">
            <option value="general" selected>Ogólna ocena</option>
            <option value="gaming">Gry online</option>
            <option value="streaming">Streaming 4K</option>
            <option value="remote_work">Praca zdalna</option>
          </select>
          <button id="analyzeBtn" class="btn secondary" disabled>Analizuj wynik</button>
          <button id="copyAnalysisBtn" class="btn secondary" disabled>Kopiuj</button>
        </div>
      </div>
      <div id="analysisMeta" class="analysis-meta"></div>
      <div id="analysisText" class="analysis">Brak analizy.</div>
    </section>
  </main>

  <script src="/vendor/chart.js/chart.umd.js"></script>
  <script src="/js/speedtest.js"></script>
</body>
</html>