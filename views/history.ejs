<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>SpeedPL — Historia testów i statystyki</title>
  <meta name="description" content="Historia pomiarów prędkości internetu SpeedPL z wykresami trendów i eksportem CSV/JSON.">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%23090d16'/%3E%3Cpath d='M7 22a11 11 0 1 1 18 0' fill='none' stroke='%233b82f6' stroke-width='3' stroke-linecap='round'/%3E%3Cpath d='M16 17l5-6' stroke='%2310b981' stroke-width='2.5' stroke-linecap='round'/%3E%3Ccircle cx='16' cy='17' r='2' fill='%23f8fafc'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body data-db-configured="<%= dbConfigured ? 'true' : 'false' %>">
  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="brand-wordmark">SpeedPL</a>
      <nav class="topbar-nav" aria-label="Nawigacja główna">
        <a href="/" class="nav-link" data-i18n="navMeasure">Pomiar</a>
        <a href="/history" class="nav-link active" data-i18n="navHistory">Historia</a>
      </nav>
      <div class="topbar-actions">
        <select id="langSelect" class="lang-select" aria-label="Język / Language / Langue">
          <option value="pl">Polski</option>
          <option value="en">English</option>
          <option value="fr">Français</option>
        </select>
        <a href="/" class="btn primary btn-sm" data-i18n="newTest">Nowy test</a>
      </div>
    </div>
  </header>

  <main class="container">
    <section class="page-intro">
      <h1 data-i18n="historyTitle">Historia pomiarów</h1>
      <p class="meta-line" id="historySourceMeta">
        <span data-i18n="historyLoading">Ładowanie...</span>
      </p>
    </section>

    <section class="metric-grid history-kpi-grid" aria-label="Podsumowanie historii">
      <div class="metric">
        <span class="metric-label" data-i18n="historyCount">Liczba testów</span>
        <div class="metric-main">
          <strong class="mono" id="kpiCount">0</strong>
        </div>
        <small class="metric-detail" data-i18n="historySessions">Zapisane sesje</small>
      </div>
      <div class="metric">
        <span class="metric-label" data-i18n="historyAvgDl">Średnie pobieranie</span>
        <div class="metric-main">
          <strong class="mono" id="kpiAvgDownload">--</strong>
          <span class="metric-unit" data-i18n="unitMbps">Mb/s</span>
        </div>
        <small class="metric-detail mono" id="kpiMaxDownload">Maks: --</small>
      </div>
      <div class="metric">
        <span class="metric-label" data-i18n="historyAvgUl">Średnie wysyłanie</span>
        <div class="metric-main">
          <strong class="mono" id="kpiAvgUpload">--</strong>
          <span class="metric-unit" data-i18n="unitMbps">Mb/s</span>
        </div>
        <small class="metric-detail mono" id="kpiMaxUpload">Maks: --</small>
      </div>
      <div class="metric">
        <span class="metric-label" data-i18n="historyMinPing">Najniższy ping</span>
        <div class="metric-main">
          <strong class="mono" id="kpiMinPing">--</strong>
          <span class="metric-unit" data-i18n="unitMs">ms</span>
        </div>
        <small class="metric-detail mono" id="kpiAvgPing">Średnio: --</small>
      </div>
    </section>

    <section class="panel" id="trendPanel" hidden>
      <div class="panel-header-inline">
        <div>
          <h2 data-i18n="historyTrendTitle">Trend prędkości</h2>
          <p class="meta-line" data-i18n="historyTrendSubtitle">Ostatnie pomiary w kolejności chronologicznej</p>
        </div>
      </div>
      <div class="chart-stage chart-stage-sm">
        <canvas id="historyChart" data-testid="history-chart"></canvas>
      </div>
    </section>

    <section class="panel">
      <div class="history-toolbar">
        <div class="toolbar-search">
          <label for="historySearch" class="sr-only" data-i18n="historySearchLabel">Filtruj historię</label>
          <input type="search" id="historySearch" class="text-input" placeholder="Filtruj po serwerze lub klasie..." data-i18n-placeholder="historySearchPlaceholder" autocomplete="off">
        </div>
        <div class="toolbar-actions">
          <button id="exportCsvBtn" class="btn secondary btn-sm" type="button" disabled data-i18n="historyExportCsv">Eksportuj CSV</button>
          <button id="exportJsonBtn" class="btn secondary btn-sm" type="button" disabled data-i18n="historyExportJson">Eksportuj JSON</button>
          <button id="refreshHistoryBtn" class="btn secondary btn-sm" type="button" data-i18n="historyRefresh">Odśwież</button>
          <button id="clearHistoryBtn" class="btn danger-ghost btn-sm" type="button" disabled data-i18n="historyClear">Wyczyść historię</button>
        </div>
      </div>

      <div id="clearConfirmBar" class="confirm-bar" hidden>
        <span id="clearConfirmText" data-i18n="<%= dbConfigured ? 'historyConfirmBoth' : 'historyConfirmLocal' %>">Czy na pewno usunąć zapisane pomiary lokalne<%= dbConfigured ? ' oraz z bazy danych' : '' %>?</span>
        <div class="confirm-actions">
          <button id="confirmClearBtn" class="btn danger btn-sm" type="button" data-i18n="historyConfirmBtn">Usuń wszystko</button>
          <button id="cancelClearBtn" class="btn secondary btn-sm" type="button" data-i18n="historyCancelBtn">Anuluj</button>
        </div>
      </div>

      <div id="historyBox" class="history-table-wrap" aria-live="polite" data-i18n="historyLoading">Ładowanie...</div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-inner">
      <span>SpeedPL</span>
      <span aria-hidden="true">·</span>
      <a href="/" data-i18n="footerBackToTest">Wróć do testu prędkości</a>
    </div>
  </footer>

  <script src="/vendor/chart.js/chart.umd.js"></script>
  <script src="/vendor/i18n.js"></script>
  <script src="/vendor/diagnostics.js"></script>
  <script src="/js/history.js"></script>
</body>
</html>
